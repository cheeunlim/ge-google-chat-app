# Copy to .env for local reference (never commit real secrets)
GE_PROJECT=your-gcp-project-id
GE_LOCATION=global
GE_APP_ID=your-gemini-enterprise-app-id
SERVICE_URL=https://ge-chat-bot-xxxxxxxxxx-du.a.run.app
OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Optional
# GE_AGENT_ID=your-custom-agent-id
# ENABLE_WEB_GROUNDING=false
